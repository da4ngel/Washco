# ============================================================
# WashCo Environment Variables
# Copy this file to `.env` (root), `backend/.env`, and set
# frontend values in `frontend/.env`. Never commit real secrets.
# ============================================================

# ---------- Supabase ----------
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---------- Stripe ----------
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# ---------- Backend ----------
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173,http://localhost:4173   # comma-separated; 5173=vite dev, 4173=vite preview
JWT_SECRET=                          # same as Supabase JWT secret (Project Settings → API → JWT Secret)

# ---------- Frontend (Vite prefix — put these in frontend/.env) ----------
VITE_API_URL=http://localhost:4000/api
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_STRIPE_PUBLISHABLE_KEY=
VITE_GOOGLE_MAPS_API_KEY=
